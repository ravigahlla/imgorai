{
  "name": "imgorai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run setup-wasm",
    "setup-wasm": "mkdir -p public/wasm && cp node_modules/c2pa/dist/assets/wasm/toolkit_bg.wasm public/wasm/ && cp node_modules/c2pa/dist/c2pa.worker.min.js public/wasm/"
  },
  "dependencies": {
    "c2pa": "^0.30.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.23",
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-wasm": "^3.4.0"
  }
}
